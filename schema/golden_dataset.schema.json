      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat_history",
        "question",
        "task_constraint",
        "metadata_filters"
      ],
      "properties": {
        "chat_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "task_constraint": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata_filters": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "null"
            ]
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "source_id"
      ],
      "properties": {
        "claim": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "distractorInjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distractor_context_ids",
        "distractor_contexts",
        "conflict_type",
        "injected_noise_ratio"
      ],
      "properties": {
        "distractor_context_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "distractor_contexts": {
          "$ref": "#/$defs/stringArray"
        },
        "conflict_type": {
          "type": "string",
          "minLength": 1
        },
        "injected_noise_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "injected_noise_ratio": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "distractor_context_ids": {
                "maxItems": 0
              },
              "distractor_contexts": {
                "maxItems": 0
              },
              "conflict_type": {
                "const": "none"
              }
            }
          },
          "else": {
            "properties": {
              "distractor_context_ids": {
                "minItems": 1
              },
              "distractor_contexts": {
                "minItems": 1
              },
              "conflict_type": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        }
      ]
    },
    "groundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_route",
        "ground_truth_standalone_query",
        "ground_truth_sub_queries",
        "sub_query_context_mapping",
        "ground_truth_context_ids",
        "ground_truth_contexts",
        "distractor_injection",
        "expected_answer",
        "key_facts_required",
        "expected_citations",
        "expected_format",
        "negative_constraints"
      ],
      "properties": {
        "expected_route": {
          "enum": [
            "rag_search",
            "direct_answer",
            "clarification_request",
            "refusal"
          ]
        },
        "ground_truth_standalone_query": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ground_truth_sub_queries": {
          "$ref": "#/$defs/stringArray"
        },
        "sub_query_context_mapping": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stringArray"
          }
        },
        "ground_truth_context_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "ground_truth_contexts": {
          "$ref": "#/$defs/stringArray"
        },
        "distractor_injection": {
          "$ref": "#/$defs/distractorInjection"
        },
        "expected_answer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "key_facts_required": {
          "$ref": "#/$defs/stringArray"
        },
        "expected_citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "expected_format": {
          "enum": [
            "markdown_text",
            "bullet_points",
            "table",
            "step_by_step"
          ]
        },
        "negative_constraints": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "scorer_version"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "computed",
            "not_applicable",
            "not_run",
            "missing_input",
            "error",
            "needs_review"
          ]
        },
        "scorer_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "array",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "computed"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "boolean"
                ]
              },
              "scorer_version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
