{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigovbot.local/schema/golden_dataset.schema.json",
  "title": "Golden Dataset — đầy đủ nhãn chấm RAG/retrieval",
  "description": "RAG reference case: evidence, conversation context and expected answer. Domain vocabulary is the existing golden corpus snapshot; aliases are not automatically merged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_id",
    "version",
    "taxonomy",
    "input",
    "ground_truth",
    "evaluation_plan"
  ],
  "properties": {
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy": {
      "$ref": "#/$defs/taxonomy"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "ground_truth": {
      "$ref": "#/$defs/groundTruth"
    },
    "evaluation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutoffs",
        "expected_action",
        "reference_answers",
        "fact_evidence",
        "sub_query_targets",
        "format_rules",
        "negative_rules",
        "robustness_pair",
        "relevance_completeness",
        "normalization_version",
        "corpus_revision"
      ],
      "properties": {
        "cutoffs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "expected_action": {
          "enum": [
            "answer",
            "partial_answer",
            "clarify",
            "abstain"
          ]
        },
        "reference_answers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "fact_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact",
              "context_ids"
            ],
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "context_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1
              }
            }
          }
        },
        "sub_query_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sub_query_id",
              "query",
              "relevant_context_ids"
            ],
            "properties": {
              "sub_query_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "relevant_context_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "format_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "description",
              "method"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "method": {
                "enum": [
                  "deterministic",
                  "judge"
                ]
              }
            }
          }
        },
        "negative_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "description",
              "method",
              "forbidden_text"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "method": {
                "enum": [
                  "literal_absence",
                  "judge"
                ]
              },
              "forbidden_text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "method": {
                      "const": "literal_absence"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "forbidden_text": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "forbidden_text": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "robustness_pair": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pair_id",
                "condition",
                "counterpart_test_id"
              ],
              "properties": {
                "pair_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "condition": {
                  "enum": [
                    "clean",
                    "noisy"
                  ]
                },
                "counterpart_test_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          ]
        },
        "relevance_completeness": {
          "enum": [
            "exhaustive",
            "known_positives_only"
          ]
        },
        "normalization_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "corpus_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "taxonomy": {
            "properties": {
              "is_unanswerable": {
                "const": true
              }
            },
            "required": [
              "is_unanswerable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ground_truth": {
            "properties": {
              "ground_truth_context_ids": {
                "maxItems": 0
              },
              "ground_truth_contexts": {
                "maxItems": 0
              },
              "expected_citations": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "ground_truth": {
            "properties": {
              "ground_truth_context_ids": {
                "minItems": 1
              },
              "ground_truth_contexts": {
                "minItems": 1
              },
              "expected_citations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taxonomy": {
            "properties": {
              "turn_type": {
                "const": "follow_up"
              }
            },
            "required": [
              "turn_type"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "properties": {
              "chat_history": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taxonomy": {
            "properties": {
              "complexity_type": {
                "const": "multi_intent"
              }
            },
            "required": [
              "complexity_type"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ground_truth": {
            "properties": {
              "ground_truth_sub_queries": {
                "minItems": 2,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taxonomy": {
            "properties": {
              "complexity_type": {
                "const": "multi_intent"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evaluation_plan": {
            "properties": {
              "sub_query_targets": {
                "minItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taxonomy": {
            "properties": {
              "is_unanswerable": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evaluation_plan": {
            "properties": {
              "fact_evidence": {
                "maxItems": 0
              },
              "expected_action": {
                "enum": [
                  "clarify",
                  "abstain"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ground_truth": {
            "properties": {
              "distractor_injection": {
                "properties": {
                  "injected_noise_ratio": {
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evaluation_plan": {
            "properties": {
              "robustness_pair": {
                "type": "object",
                "properties": {
                  "condition": {
                    "const": "noisy"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taxonomy": {
            "properties": {
              "is_unanswerable": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evaluation_plan": {
            "properties": {
              "fact_evidence": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
