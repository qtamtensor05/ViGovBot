                "number",
                "null"
              ]
            },
            "rouge_2_f1": {
              "type": [
                "number",
                "null"
              ]
            },
            "rouge_l_precision": {
              "type": [
                "number",
                "null"
              ]
            },
            "rouge_l_recall": {
              "type": [
                "number",
                "null"
              ]
            },
            "rouge_l_f1": {
