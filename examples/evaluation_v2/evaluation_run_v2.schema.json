{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vigov/evaluation-run-v2.schema.json",
  "title": "Vigov Evaluation Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "test_id",
    "split",
    "golden",
    "system_execution_output",
    "evaluation_results"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "val",
        "test",
        "unknown"
      ]
    },
    "golden": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "taxonomy",
        "input",
        "ground_truth"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "taxonomy": {
          "type": "object"
        },
        "input": {
          "type": "object"
        },
        "ground_truth": {
          "type": "object"
        }
      }
    },
    "system_execution_output": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "model_config",
        "query_processing",
        "retrieval_output",
        "generation_output",
        "performance",
        "execution_status"
      ],
      "properties": {
        "model_config": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "architecture_type",
            "model_name"
          ]
        },
        "query_processing": {
          "type": "object",
          "properties": {
            "actual_sub_queries": {
              "type": ["array", "null"],
              "items": {"type": "object", "required": ["sub_query_id", "query"],
                "properties": {"sub_query_id": {"type": "string"}, "query": {"type": "string", "minLength": 1}}}
            }
          }
        },
        "retrieval_output": {
          "type": "object",
          "properties": {
            "retrieval_top_k": {"type": ["integer", "null"], "minimum": 1},
            "sub_query_retrieval": {"type": ["object", "null"], "additionalProperties": {"type": "array", "items": {"type": "string"}}}
          }
        },
        "generation_output": {
          "type": "object",
          "required": [
            "actual_output"
          ],
          "properties": {
            "actual_output": {
              "type": [
                "string",
                "null"
              ]
            },
            "extracted_claims": {"type": "array", "items": {"type": "object", "required": ["text", "source_ids", "verdict"],
              "properties": {"text": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "items": {"type": "string"}},
                "verdict": {"enum": ["supported", "contradicted", "unknown"]}}}}
          }
        },
        "performance": {
          "type": "object"
        },
        "execution_status": {
          "enum": [
            "success",
            "timeout",
            "oom",
            "error",
            "not_run"
          ]
        }
      }
    },
    "evaluation_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_based_scores",
        "query_processing_scores",
        "retrieval_scores",
        "generation_scores",
        "robustness_and_style_scores",
        "performance_scores",
        "pairwise_arena",
        "human_calibration",
        "metric_details",
        "quality_gates",
        "error_analysis"
      ],
      "properties": {
        "reference_based_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_match",
            "normalized_exact_match",
            "token_precision",
            "token_recall",
            "token_f1",
            "rouge_1_precision",
            "rouge_1_recall",
            "rouge_1_f1",
            "rouge_2_precision",
            "rouge_2_recall",
            "rouge_2_f1",
            "rouge_l_precision",
            "rouge_l_recall",
            "rouge_l_f1",
            "bertscore_precision",
            "bertscore_recall",
            "bertscore_f1",
            "embedding_cosine_similarity",
            "chrf",
            "chrf_pp",
            "sacrebleu",
            "meteor",
            "character_error_rate",
            "word_error_rate"
