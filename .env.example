# Pipeline settings have moved to configs/*.yaml.
# API key referenced by web.models[].api_key_env (do not put the key in YAML).
MODEL_API_KEY=

# Optional Hugging Face token for gated/private assets. Qwen2.5-7B-Instruct is public.
HF_TOKEN=

# Host port for the Docker web UI/API. Container port remains 8000.
VIGOVBOT_WEB_PORT=8001

# Nested config override example (values are parsed as YAML):
# VIGOVBOT_QLORA__DATA__OUTPUT_DIR=/mnt/training/outputs/qlora

# Required by Compose: existing host directory containing adapter_config.json and weights.
QLORA_ADAPTER_PATH=./outputs/qlora/best_adapter
